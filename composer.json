{
    "name": "nico0420/line-pay",
    "description": "line pay v3 package.",
    "version": "1.2.0",
    "type": "package",
    "require": {
        "php": ">=5.5",
        "composer/installers": "~1.0",
        "guzzlehttp/guzzle": "^7.7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "5.7",
        "fzaninotto/faker": "^1.9"
    },
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Kevin Li",
            "email": "nicokie0420@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "NICO0420\\LinePay\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
